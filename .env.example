# Example environment variables for ForgeAI
# Replace the values with your actual API keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Groq is primary; Gemini is the secondary provider for quota/temporary failures.
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=gemini
# To run strictly local inference, set LLM_PROVIDER=ollama. Ollama mode never
# falls back to Groq or Gemini, even if LLM_FALLBACK_PROVIDER remains gemini.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_OUTPUT_TOKENS=1024
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
# Local Groq request pacing and bounded retry policy. Provider-side limits
# remain authoritative; HTTP 429 retry guidance is handled separately.
GROQ_LOCAL_REQUESTS_PER_MINUTE=15
GROQ_MAX_RETRIES=2
# Local estimated-token rolling-window guards (input estimate + output reserve).
# These are application safeguards, not the provider's actual TPM/quota limits;
# Groq HTTP 429 responses continue to be handled separately.
GROQ_LOCAL_TPM_70B=10000
GROQ_LOCAL_TPM_8B=5000
# Optional global local-guard override for all Groq models:
# GROQ_LOCAL_TOKENS_PER_MINUTE=10000
# Optional: override the default Groq model
# GROQ_MODEL=openai/gpt-oss-120b
LLM_REQUESTS_PER_MINUTE=15
LLM_REQUEST_TIMEOUT_SECONDS=90
# The Gemini model is verified as available to the configured account and
# supports generateContent with the installed google-genai SDK.
GEMINI_MODEL=gemini-3.8-flash
# Optional per-stage overrides: GEMINI_MODEL_SPEC, GEMINI_MODEL_CODEGEN, GEMINI_MODEL_FIX
